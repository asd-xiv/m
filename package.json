{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@asd14/m",
  "version": "9.1.0",
  "description": "Point free style, functional Javascript library with focus on object arrays",
  "license": "MIT",
  "homepage": "https://github.com/asd-xiv/m",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "tags": [
      "type:library",
      "target:any"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asd-xiv/m.git"
  },
  "bugs": {
    "url": "https://github.com/asd-xiv/m/issues"
  },
  "author": {
    "name": "Andrei Dumitrescu",
    "url": "https://github.com/andreidmt"
  },
  "contributors": [
    {
      "name": "David Gil",
      "url": "https://github.com/dgilperez"
    }
  ],
  "keywords": [
    "point-free",
    "functional",
    "javascript",
    "library"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "dist/types",
    "docs/**/*.md",
    ".ai"
  ],
  "scripts": {
    "----UTIL": "",
    "prepare": "git config --local core.hooksPath .githook",
    "update": "ncu --interactive",
    "postupdate": "npm audit fix",
    "format": "prettier --write --prose-wrap=always . && eslint --fix src",
    "----BUNDLE": "",
    "build:code": "swc src -d 'dist' --ignore '**/*.test.ts,**/*.tst.ts,**/test/**,**/bench/**'",
    "build:types": "tsc --declaration --emitDeclarationOnly --project ./.tsconfig/code.json",
    "build:docs": "documentation build dist/src/index.js --project-name '@asd14/m' -f html -o dist/docs -c documentation.yml --infer-private '^_'",
    "prebuild": "rm -rf dist/* node_modules/.tmp/tsconfig.*.tsbuildinfo",
    "build": "npm run build:code && npm run build:types",
    "----LINT": "",
    "lint": "eslint --quiet .",
    "typecheck:code": "tsc --noEmit --project ./.tsconfig/code.json",
    "typecheck:config": "tsc --noEmit --project ./.tsconfig/config.json",
    "typecheck:tests": "tsc --noEmit --project ./.tsconfig/tests.json",
    "typecheck": "npm run typecheck:code && npm run typecheck:config && npm run typecheck:tests",
    "----TEST": "",
    "unit-test": "node --import tsx --test 'src/**/*.test.ts' 'src/**/test/*.ts'",
    "type-test": "tstyche",
    "bench": "for file in $(find src -path '*/bench/*.ts' ! -name '_*'); do echo \"# $file\"; node --import tsx \"$file\"; done",
    "tdd": "nodemon --watch src --exec 'npm run unit-test && npm run type-test'",
    "coverage": "c8 --100 --exclude='src/**/*.test.ts' --exclude='src/**/test/**' npm run unit-test",
    "----PUBLISH": "",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@asd14/eslint-config": "^17.1.0",
    "@asd14/eslint-plugin": "^3.5.0",
    "@asd14/prettier-config": "^1.6.0",
    "@asd14/semantic-release-config": "^2.0.0",
    "@asd14/ts-config": "^2.1.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/lodash": "^4.17.27",
    "@types/ramda": "^0.32.0",
    "@types/tape": "^5.8.1",
    "@types/underscore": "^1.13.0",
    "c8": "^12.0.0",
    "chi-squared-test": "^1.1.0",
    "documentation": "^14.0.3",
    "eslint": "^9.39.5",
    "lodash": "^4.18.1",
    "nodemon": "^3.1.14",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.10.1",
    "rambda": "^11.4.0",
    "ramda": "^0.32.0",
    "semantic-release": "^26.0.1",
    "tape": "^5.11.0",
    "tinybench": "^6.2.5",
    "tstyche": "^7.2.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "underscore": "^1.13.8"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.13",
      "onFail": "warn"
    }
  }
}
